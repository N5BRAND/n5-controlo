# Base de dados (Postgres 16, RDS na UE em produção)
DATABASE_URL=postgres://n5:n5@localhost:5432/n5

# Sessões da equipa: string aleatória com 32+ caracteres
SESSION_SECRET=troca-isto-por-uma-string-aleatoria-longa

# Endereço público da app (para links nos alertas)
APP_URL=http://localhost:3000

# Stripe: segredo do endpoint de webhooks
STRIPE_WEBHOOK_SECRET=

# GitHub App: segredo dos webhooks
GITHUB_WEBHOOK_SECRET=

# Slack: signing secret da app da comunidade N5 e token do bot (para responder em threads)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALERTS_CHANNEL=n5-alertas

# Meta Marketing API: token de sistema com ads_read
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
# API de Conversões (inscrições e compras confirmadas pela Stripe): token do Gestor de Eventos
META_CAPI_TOKEN=
# Conjunto de dados (predefinido: Nº5, 2268439390668297)
META_PIXEL_ID=
# Só para testar no separador «Testar eventos»; apagar depois
META_CAPI_TEST_CODE=
# Payment Links que contam como compra: plink_x:sw_clara,plink_y:sw_imobiliario (a pré-reserva da Clara já vem predefinida)
META_CAPI_PAYMENT_LINKS=
# Orçamentos ABO: token de sistema com ads_management, para as regras mudarem os orçamentos.
# Sem ele, as decisões ficam só propostas em Campanhas e funil.
META_ADS_TOKEN_GESTAO=

# Tarefas agendadas (alertas, sincronização Meta, snapshot do MRR): segredo partilhado com o agendador
CRON_SECRET=

# E-mail (módulo Reativação): Amazon SES na UE. Sem SES_FROM_ADDRESS os envios ficam simulados.
# O endereço tem de estar verificado no SES, com SPF, DKIM e DMARC no domínio.
SES_FROM_ADDRESS=
SES_REGION=eu-west-1

# IA para os resumos do Chat (opcional): Amazon Bedrock na UE. Sem isto os resumos fazem-se por regras.
# Credenciais AWS pelo papel da função (IAM) ou AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
LLM_PROVIDER=
BEDROCK_MODEL_ID=
BEDROCK_REGION=eu-central-1

# Câmbio USD -> EUR usado no registo de consumo enquanto não houver taxa diária
USD_EUR_RATE=0.87

# Só fora da produção: palavra-passe dos logins de exemplo do seed (12+ caracteres). Sem ela, o seed gera uma.
DEMO_PASSWORD=

{
  "name": "n5-controlo",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Controlo N5: comunidades, pipeline, campanhas e funil, utilização e receita",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "apikey:create": "tsx scripts/create-api-key.ts",
    "start:render": "npm run db:migrate && npm run db:seed -- --if-empty && next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1149.0",
    "@aws-sdk/client-sesv2": "3.1149.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.44.5",
    "jose": "6.1.0",
    "next": "15.5.28",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
